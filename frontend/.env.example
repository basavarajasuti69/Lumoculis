# Local frontend configuration
# Prediction API base URL (local FastAPI or deployed Render service)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional server-side Grad-CAM configuration.
# Never prefix these secret values with NEXT_PUBLIC_.
MODAL_GRADCAM_URL=https://YOUR-MODAL-APP.modal.run/gradcam
MODAL_GRADCAM_TOKEN=replace-with-your-modal-bearer-token

# Optional distributed rate limiting for /api/gradcam.
# Without both values, the route runs without rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
